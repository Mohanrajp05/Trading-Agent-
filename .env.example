# Environment Variables Template

# Required API Keys (copy from .env.example to .env and replace with your actual keys)
OPENAI_API_KEY=your_openai_api_key_here
TICKETMASTER_KEY=your_ticketmaster_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_grok_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MASSIVE_API_KEY=your_massive_api_key_here
PUSHOVER_USER=your_pushover_user_key
PUSHOVER_TOKEN=your_pushover_token

# Model Configuration
MODEL=gpt-4o-mini
USE_MANY_MODELS=true
RUN_EVEN_WHEN_MARKET_IS_CLOSED=true

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# Other Configuration
DEFAULT_CURRENCY=USD
MAX_POSITION_SIZE=1000000
RISK_THRESHOLD=0.05

# Indian Market (Optional - yfinance works without API key)
# ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key_here