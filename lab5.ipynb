   "source": [
    "from backend.api import app\n",
    "\n",
    "for route in app.routes:\n",
    "    methods = getattr(route, \"methods\", None)\n",
    "    if methods and route.path.startswith(\"/api\"):\n",
    "        print(sorted(methods), route.path)"
   ]
